#!/usr/bin/env bash
# 🧰 apptool — ship + deploy any appkit Android app · run fr th app's repo root · config + hooks = th app's bin/lib.sh
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/apptool.sh"
VERSION=0.1.0

usage() {
    cat <<EOF
apptool $VERSION — 1 release + dev tool 4 evy appkit Android app (y: ship / deploy = same steps i evy app, fixed once)

usage: apptool <cmd> [args]   (run fr th app's repo root · reads bin/lib.sh = config + hooks)

  deploy [-a] [-q] [-r]       🧪 DEV build ➡ <web>/dev/ (th DEV app updates itself, o Obtainium)
  ship [patch|minor|major|X.Y.Z] [-p]   📦 release ➡ <web>/ + git tag + GitHub release
  page                        re-render + upload th stable page only (= ship -p)
  oblink [dev]                print th "➕ Add to Obtainium" link
  version                     print appVersion (last shipped)
  -h, --help                  this · <cmd> -h = that cmd's help
  -V, --version               apptool version

examples:
  apptool deploy -a           dev build ➡ web + install over wireless adb
  apptool ship minor          bump 0.8.0 ➡ 0.9.0, tag, APK, page, GitHub release
  apptool page                page tpl changed ➡ re-render 4 th last shipped version

app config (bin/lib.sh): README.md § tool
EOF
}

# th app: config + hooks (page · publish_dir · publish_done · tools) · no page() ➡ th kit's template page
[ -f bin/lib.sh ] || { echo "❌ no bin/lib.sh here ➡ run fr th app's repo root (README.md § adopt)"; exit 1; }
. bin/lib.sh
declare -F page >/dev/null || . "$APPKIT/templates/page.sh"
for v in APP FILE PKG WEB DIRS SRC; do [ -n "${!v:-}" ] || { echo "❌ bin/lib.sh: $v not set (README.md § tool)"; exit 1; }; done
ANDROID_DIR=${ANDROID_DIR:-android}; MODULE=${MODULE:-app}; GRADLE_APP=${GRADLE_APP:-$ANDROID_DIR/$MODULE/build.gradle.kts}
NOTES=${NOTES:-bin/notes.py}; GH_REMOTE=${GH_REMOTE:-gh}; GH_REPO=${GH_REPO:-${SRC#https://github.com/}}
MAIN_ACTIVITY=${MAIN_ACTIVITY:-$PKG.MainActivity}
footer() { declare -F tools >/dev/null && tools || true; }
out=""   # tmp build dir (deploy · ship) · global 4 th EXIT trap

# 🆕 page hook + guard: th updater reads version.json ➡ a page hook th forgot it = fons nvr update
render() {
    page "$@"
    [ -s "$1/version.json" ] || { echo "🐛 page() wrote no version.json ➡ call version_json (README.md § tool)"; exit 1; }
}

# ── 🧪 deploy ────────────────────────────────────────────────────────────────────────────────────────
deploy_usage() {
    cat <<EOF
usage: apptool deploy [-a|--adb] [-q|--quiet] [-r|--qr] [-h|--help]

  y: tst a change on ur own fon i ~1 min, wo a release, a tag o touching th friends' stable app

  🧪 dev build "$APP DEV" ($PKG.dev), version <next release>-dev.MMDD.HHMM (newer evy minute), no commit needed
     next release = appVersion if not shipped yet, else th next minor (0.8.0 shipped ➡ 0.9.0-dev…) · nvr bump by hand

  (default)   ➡ $WEB/dev/  ➡ th DEV app: notification / banner ➡ Install (o Obtainium: pull 2 refresh ➡ Update)
  -a --adb    + install th same apk over wireless adb right now (home wifi, opens th app)
  -q --quiet  w -a: install only, don't open th app (u r using th fon)
  -r --qr     only print a QR o $WEB/dev/ (fon camera ➡ page) + th raw obtainium:// link, no build

  wireless adb once: fon ➡ Developer options ➡ Wireless debugging ➡ "Pair w code"
                     ➡ adb pair IP:PORT  (then it reconnects by itself via mDNS) · lessons/fon_debug.md
  release 4 friends: apptool ship

EOF
    footer
}

deploy() {
    local adb=0 launch=1 a
    for a in "$@"; do
        case "$a" in
            -h|--help|-\?) deploy_usage; exit 0 ;;
            -a|--adb) adb=1 ;;
            -q|--quiet) launch=0 ;;
            -r|--qr) qrencode -t ansiutf8 -m 2 "$WEB/dev/"; echo "$WEB/dev/"; echo; oblink "$PKG.dev" "$WEB/dev/" "$APP DEV"; exit 0 ;;
            *) deploy_usage; exit 1 ;;
        esac
    done

    if [ "$adb" = 1 ]; then   # check th fon 1st ➡ fail b4 a 1-min build
        have_fon() { "$ADB" devices | grep -qE '\sdevice$'; }
        if ! have_fon; then
            # _adb-tls-connect = a paired fon w Wireless debugging on · last col = IP:PORT (port changes evy toggle)
            "$ADB" mdns services | awk '/_adb-tls-connect/ {print $NF}' | while read -r hp; do
                "$ADB" connect "$hp" >/dev/null 2>&1 || true
            done
        fi
        have_fon || { echo "📱 no fon: Wireless debugging ON + same wifi? · 1st time: adb pair IP:PORT"; exit 1; }
    fi

    # -Pdev ➡ versionName gets -dev.MMDD.HHMM (tool/app-version.gradle.kts) ➡ updater + Obtainium see a new version
    # dev = test build o th NEXT release: appVersion alr shipped (tag exists) ➡ label as next minor (0.8.0 ➡ 0.9.0-dev…)
    local base ver apk live   # out = global: th EXIT trap runs aftr this fn's locals r gone (set -u)
    base=$(app_version)
    if git rev-parse -q --verify "refs/tags/v$base" >/dev/null; then
        IFS=. read -r ma mi _ <<<"$base"; base="$ma.$((mi + 1)).0"
    fi
    (cd "$ANDROID_DIR" && ./gradlew --offline -q ":$MODULE:assembleDebug" -Pdev -PdevBase="$base")
    local built=$ANDROID_DIR/$MODULE/build/outputs/apk/debug
    ver=$(sed -nE 's/.*"versionName": "([^"]+)".*/\1/p' "$built/output-metadata.json" | head -1)
    out=$(mktemp -d); trap 'rm -rf "$out"' EXIT
    apk="$FILE-$ver.apk"
    cp "$built/$MODULE-debug.apk" "$out/$apk"
    # 🔢 guard: an Obtainium entry on defaults only sees th hash o th 1st 1 KiB (tool/app-version.gradle.kts stamp) ➡ same as live = fon nvr updates
    live=$(curl -sf --max-time 10 "$WEB/dev/version.json" | sed -nE 's/.*"apk":"([^"]+)".*/\1/p') || true
    if [ -n "$live" ] && [ "$live" != "$apk" ]; then
        if [ "$(curl -sf --max-time 20 -r 0-1023 "$WEB/dev/$live" | sha256sum)" = "$(head -c 1024 "$out/$apk" | sha256sum)" ]; then
            echo "🐛 1st 1 KiB = same as live $live ➡ Obtainium (defaults) won't see an update · stamp broke? (appkit tool/app-version.gradle.kts)"; exit 1
        fi
    fi
    render "$out" "$ver" "$apk" dev
    publish "$out" dev
    echo "✔️ $ver ➡ $WEB/dev/ · fon: DEV app ➡ Install (o Obtainium ➡ pull 2 refresh)"

    if [ "$adb" = 1 ]; then
        "$ADB" install -r "$out/$apk" >/dev/null
        [ "$launch" = 1 ] && "$ADB" shell am start -n "$PKG.dev/$MAIN_ACTIVITY" >/dev/null
        echo "✔️ + installed over adb$([ "$launch" = 1 ] && echo ' + launched')"
    fi
}

# ── 📦 ship ──────────────────────────────────────────────────────────────────────────────────────────
ship_usage() {
    cat <<EOF
usage: apptool ship [patch|minor|major|X.Y.Z] [-p|--page] [-h|--help]

  y: 1 cmd = version bump + tag + APK + page + GitHub release ➡ evy install sees it, nothing half-shipped

  📦 release: build release APK ➡ $WEB/ (page + version.json = th in-app updater's source, Obtainium follows it too) + GitHub release v<version>
  minor       0.7.0 ➡ 0.8.0 = new features  ┐ bumps fr th last shipped tag ➡ writes appVersion ➡
  patch       0.8.0 ➡ 0.8.1 = only fixes    ├ commits "vX.Y.Z" + pushes ➡ ships
  major       0.8.0 ➡ 1.0.0                 ┘
  X.Y.Z       exactly this version (= wh th DEV app shows, e.g. 0.10.0) · must be > th last shipped tag
  (none)      ship appVersion as it is (must not be shipped yet)
  ⚠️ appVersion = th LAST SHIPPED version · DEV builds show th NEXT one (0.10.0-dev…) ➡ that gap is normal
  -p --page   only re-render + upload th page (page tpl changed) 4 th last shipped version · no build, no tag

  before:
    1. release notes 4 th NEW version ($NOTES X.Y.Z must print them = in-app + GitHub notes)
    2. commit + push evythg else (th tag = exactly th shipped code; script refuses otherwise)
  signed w ~/.android/debug.keystore ➡ ⚠️ lose it = evy install must uninstall
  dev builds (no commit needed, version = last ship + "-dev.MMDD.HHMM"): apptool deploy

EOF
    footer
}

ship() {
    local level="" want="" only_page=""
    case "${1:-}" in
        -h|--help|-\?) ship_usage; exit 0 ;; -p|--page) only_page=1 ;; patch|minor|major) level=$1 ;;
        [0-9]*.[0-9]*.[0-9]*) [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { ship_usage; exit 1; }; level=exact; want=$1 ;;
        "") ;; *) ship_usage; exit 1 ;;
    esac
    local ver apk   # out = global (EXIT trap, see deploy)
    if [ -n "$only_page" ]; then
        # last shipped = newest v* tag · apk comes fr th server (size + sha + versionCode = exactly what ppl download)
        ver=$(git tag -l 'v*' --sort=-v:refname | head -1); ver=${ver#v}
        [ -n "$ver" ] || { echo "❌ no v* tag ➡ nothing shipped yet"; exit 1; }
        out=$(mktemp -d); trap 'rm -rf "$out"' EXIT
        apk="$FILE-$ver.apk"
        curl -fsSo "$out/$apk" "$WEB/$apk" || { echo "❌ $WEB/$apk not on th server"; exit 1; }
        render "$out" "$ver" "$apk"
        rm "$out/$apk"                     # page only ➡ publish skips th apk upload
        publish "$out"
        echo "✔️ page re-rendered 4 v$ver ➡ $WEB/"
        exit 0
    fi

    ver=$(app_version)
    [ -n "$ver" ] || { echo "❌ no appVersion i $GRADLE_APP"; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "❌ uncommitted changes ➡ commit 1st"; exit 1; }
    git fetch -q origin && [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "❌ HEAD ≠ origin/main ➡ push 1st"; exit 1; }
    # 🛡️ app's own ship guard (eg langs claimed wo files) ➡ b4 bump/commit/tag
    if [ -n "${SHIP_GUARD:-}" ]; then $SHIP_GUARD || exit 1; fi

    # 🔢 bump: fr th last shipped tag (not fr appVersion ➡ "minor" twice = still 1 step)
    if [ -n "$level" ]; then
        local last next newest ma mi pa
        last=$(git tag -l 'v*' --sort=-v:refname | head -1); last=${last#v}
        IFS=. read -r ma mi pa <<<"${last:-0.0.0}"
        case "$level" in major) next="$((ma + 1)).0.0" ;; minor) next="$ma.$((mi + 1)).0" ;; patch) next="$ma.$mi.$((pa + 1))" ;; exact) next=$want ;; esac
        # X.Y.Z must be newer than th last tag (sort -V: 0.10.0 > 0.9.0, not string order)
        newest=$(printf '%s\n%s\n' "${last:-0.0.0}" "$next" | sort -V | tail -1)
        if [ "$next" = "${last:-}" ] || [ "$newest" != "$next" ]; then echo "❌ $next ≤ last shipped v${last:-–} ➡ pick a newer version"; exit 1; fi
        if [ "$next" != "$ver" ]; then
            [ -n "$($NOTES "$next")" ] || { echo "❌ no release notes 4 $next ($NOTES $next prints nothing) ➡ write th notes 1st"; exit 1; }
            sed -i -E "s/^val appVersion = \"[^\"]+\"/val appVersion = \"$next\"/" "$GRADLE_APP"
            git commit -qm "v$next" "$GRADLE_APP" && git push -q origin main
            echo "🔢 $ver ➡ $next (committed + pushed)"
            ver=$next
        fi
    fi
    git rev-parse -q --verify "refs/tags/v$ver" >/dev/null && { echo "❌ v$ver alr shipped ➡ apptool ship patch|minor|major"; exit 1; }
    [ -n "$($NOTES "$ver")" ] || { echo "❌ no release notes 4 $ver ($NOTES $ver prints nothing) ➡ write th notes 1st"; exit 1; }

    (cd "$ANDROID_DIR" && ./gradlew --offline -q ":$MODULE:assembleRelease")
    out=$(mktemp -d); trap 'rm -rf "$out"' EXIT
    apk="$FILE-$ver.apk"
    cp "$ANDROID_DIR/$MODULE/build/outputs/apk/release/$MODULE-release.apk" "$out/$apk"
    render "$out" "$ver" "$apk"
    publish "$out"

    # 🏷️ annotated tag on th shipped commit (notes inside ➡ `git show vX.Y.Z`) · local + pushed
    # remotes: origin = Forgejo (only push target) · $GH_REMOTE = GitHub, fetch-only
    #   GitHub gets code + tags via th Forgejo push-mirror (on evy push) ➡ wait til th tag lands there, `--verify-tag` needs it
    git tag -a "v$ver" -m "$APP $ver"$'\n\n'"$($NOTES "$ver")"
    git push -q origin "v$ver"
    echo "⏳ waiting 4 th Forgejo ➡ GitHub mirror 2 carry v$ver (≤120 s)"
    local deadline=$((SECONDS + 120))
    until git ls-remote --exit-code "$GH_REMOTE" "refs/tags/v$ver" >/dev/null 2>&1; do
        [ $SECONDS -lt $deadline ] || { echo "❌ v$ver not on GitHub aftr 120 s ➡ mirror down? (ops: repo mirror ${GH_REPO#*/}) · page + Forgejo tag alr live, rerun only th gh release step"; exit 1; }
        sleep 5
    done
    # GitHub release = th archive: evy version stays downloadable · notes = th in-app changelog
    gh release create "v$ver" "$out/$apk" --repo "$GH_REPO" --verify-tag --title "$APP $ver" \
        --notes "$($NOTES "$ver")"$'\n\n'"Install: open $WEB/ on the phone, or download the APK below. Older versions: see all releases."
    git fetch -q --tags origin
    echo "✔️ shipped v$ver ➡ $WEB/"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
    deploy) deploy "$@" ;;
    ship) ship "$@" ;;
    page) ship -p ;;
    oblink) if [ "${1:-}" = dev ]; then oblink "$PKG.dev" "$WEB/dev/" "$APP DEV"; else oblink "$PKG" "$WEB/" "$APP"; fi ;;
    version) app_version ;;
    -V|--version) echo "apptool $VERSION" ;;
    -h|--help|-\?|"") usage; footer ;;
    *) usage; exit 1 ;;
esac
