<?xml version="1.0" encoding="utf-8"?>
<!-- 🆕 appkit :selfupdate · merged into th app's manifest · th app still owns its FileProvider (README § adopt) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- reads <web>/version.json + downloads th apk · th kit needs it, so th kit declares it (an offline app hd none) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "🆕 X is out" · "✔️ installed" · Android 13+: th app asks at runtime (kit only checks it) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- hands th downloaded apk 2 Android's installer · usr allows "this source" once -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 🤫 Android 14+: silent self-updates once we r th installer o record (Android 12+ feature) · normal perm, no prompt -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!-- PackageInstaller session result · aft a silent update: "installed ✔️" (SelfUpdateWorker.kt) -->
        <receiver android:name="appkit.selfupdate.InstallReceiver" android:exported="false" />
        <receiver android:name="appkit.selfupdate.UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
