<?xml version="1.0" encoding="utf-8"?>
<!-- 📱 home-screen widget (notify/Widget.kt) · dflt txt = what th widget picker preview shows -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_evening"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 🥚 feast day ➡ th day's egg (D-066) left o th head · else GONE + "☭" i th txt
         ImageView, not a compound drawable: RemoteViews can only set those fr res ids, th egg = a drawn bitmap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/egg"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☭ Marx-Losung  ·  🔥 7"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/quote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:maxLines="6"
        android:text="„Das Kapital ist verstorbne Arbeit, die sich nur vampyrmäßig belebt durch Einsaugung lebendiger Arbeit.“"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="— Karl Marx, Kapital 8,9"
        android:textColor="#DDFFFFFF"
        android:textSize="12sp" />
</LinearLayout>
